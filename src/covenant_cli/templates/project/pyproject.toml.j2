[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "A governed agent project."
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "openai>=1.0",
    "openai-agents>=0.1",
    "pydantic>=2.0",
]

[tool.hatch.build.targets.wheel]
packages = ["src"]
