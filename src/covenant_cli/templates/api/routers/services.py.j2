"""{{ project_name }} -- Service endpoints."""

import json
import uuid
import threading
from pathlib import Path

from fastapi import APIRouter, HTTPException

from models.schemas import ServiceOut, TriggerRequest, TriggerResponse
from runner import run_service_background

router = APIRouter()

REGISTRY_PATH = Path("registry/agents.json")


def _load_registry() -> dict:
    """Load the project registry."""
    if not REGISTRY_PATH.exists():
        return {"agents": [], "services": []}
    return json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))


def _count_runs(service_slug: str) -> tuple[int, float | None]:
    """Count runs and compute success rate for a service."""
    inheritance_dir = Path("memory/inheritance")
    if not inheritance_dir.exists():
        return 0, None

    total = 0
    successes = 0
    for f in inheritance_dir.glob("*.json"):
        try:
            report = json.loads(f.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            continue
        if report.get("service") == service_slug or report.get("agentId", "").startswith(service_slug):
            total += 1
            if report.get("mandateCompleted", False):
                successes += 1

    rate = round((successes / total) * 100, 1) if total > 0 else None
    return total, rate


@router.get("", response_model=list[ServiceOut])
def list_services():
    """List all registered services."""
    registry = _load_registry()
    services = registry.get("services", [])
    result = []
    for svc in services:
        slug = svc.get("slug", svc.get("name", "").replace("-", "_").lower())
        runs, rate = _count_runs(slug)
        result.append(ServiceOut(
            name=svc.get("name", slug),
            slug=slug,
            sdk=svc.get("sdk", "unknown"),
            status=svc.get("status", "registered"),
            runs=runs,
            success_rate=rate,
        ))
    return result


@router.get("/{slug}", response_model=ServiceOut)
def get_service(slug: str):
    """Get details for a single service."""
    registry = _load_registry()
    services = registry.get("services", [])
    for svc in services:
        svc_slug = svc.get("slug", svc.get("name", "").replace("-", "_").lower())
        if svc_slug == slug:
            runs, rate = _count_runs(slug)
            return ServiceOut(
                name=svc.get("name", slug),
                slug=svc_slug,
                sdk=svc.get("sdk", "unknown"),
                status=svc.get("status", "registered"),
                runs=runs,
                success_rate=rate,
            )
    raise HTTPException(status_code=404, detail=f"Service '{slug}' not found")


@router.post("/{slug}/trigger", response_model=TriggerResponse)
def trigger_service(slug: str, body: TriggerRequest | None = None):
    """Trigger a service run in the background. Returns a run_id immediately."""
    registry = _load_registry()
    services = registry.get("services", [])
    found = any(
        svc.get("slug", svc.get("name", "").replace("-", "_").lower()) == slug
        for svc in services
    )
    if not found:
        raise HTTPException(status_code=404, detail=f"Service '{slug}' not found")

    run_id = str(uuid.uuid4())
    input_data = body.input_data if body else None

    thread = threading.Thread(
        target=run_service_background,
        args=(slug, run_id, input_data),
        daemon=True,
    )
    thread.start()

    return TriggerResponse(run_id=run_id, status="started")
