{% raw %}{% extends "base.html" %}

{% block title %}Pipeline #{{ group.id }}{% endblock %}

{% block content %}
<div class="page-header">
    <div class="breadcrumb">
        <a href="{% url 'dashboard:index' %}">Dashboard</a> &rsaquo; Pipeline #{{ group.id }}
    </div>
    <h1 id="pipeline-title">
        {% if all_complete %}
            Pipeline Complete
        {% else %}
            Pipeline Running
        {% endif %}
    </h1>
    <span id="pipeline-badge" class="badge badge-{{ group.status }}">{{ group.get_status_display }}</span>
</div>

<div class="pipeline-query">
    <span class="pipeline-query-label">Input</span>
    <p>{{ group.user_input }}</p>
</div>

<div id="polling-indicator" class="refresh-indicator" {% if all_complete %}style="display:none"{% endif %}>
    <span class="refresh-dot"></span> <span id="polling-label">Polling for updates...</span>
</div>

<!-- Pipeline Steps -->
<div id="pipeline-steps" class="pipeline-steps">
    {% for run in runs %}
    <div class="pipeline-step pipeline-step--{{ run.status }}" data-run-id="{{ run.id }}">
        <div class="pipeline-step-header">
            <span class="pipeline-step-number">{{ forloop.counter }}</span>
            <div class="pipeline-step-title">
                <h3>{{ run.service.name }}</h3>
                <span class="badge badge-{{ run.status }} step-badge">{{ run.get_status_display }}</span>
            </div>
        </div>
        <div class="pipeline-step-body step-body-content">
            {% if run.status == "running" %}
            <p class="running-text"><span class="spinner"></span> Processing...</p>
            {% elif run.status == "completed" %}
                {% if run.duration_seconds is not None %}
                <div class="step-meta">
                    <span class="step-meta-item">
                        <span class="step-meta-icon">&#9201;</span> {{ run.duration_seconds|floatformat:1 }}s
                    </span>
                    {% if run.tokens_used %}
                    <span class="step-meta-item">
                        <span class="step-meta-icon">&#9671;</span> {{ run.tokens_used }} tokens
                    </span>
                    {% endif %}
                </div>
                {% endif %}

                {# ---- Structured metrics grid ---- #}
                {% if run.exit_report.metrics %}
                <div class="metrics-grid fade-in stagger-children">
                    {% for m in run.exit_report.metrics %}
                    <div class="metric-tile">
                        <span class="metric-label">{{ m.label }}</span>
                        <span class="metric-value">{{ m.value }}</span>
                        {% if m.change %}
                        <span class="metric-trend metric-trend--{{ m.trend }}">
                            <span class="trend-arrow">{% if m.trend == 'up' %}&#8593;{% elif m.trend == 'down' %}&#8595;{% else %}&#8596;{% endif %}</span>
                            {{ m.change }}
                        </span>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}

                {# ---- Structured data cards ---- #}
                {% if run.exit_report.sections %}
                <div class="fade-in stagger-children">
                    {% for section in run.exit_report.sections %}
                    <div class="data-card">
                        <div class="data-card-header"><h3>{{ section.title }}</h3></div>
                        <div class="data-card-body">
                            {% if section.type == "metrics" and section.data %}
                            <div class="metrics-grid">
                                {% for m in section.data %}
                                <div class="metric-tile">
                                    <span class="metric-label">{{ m.label }}</span>
                                    <span class="metric-value">{{ m.value }}</span>
                                    {% if m.change %}
                                    <span class="metric-trend metric-trend--{{ m.trend }}">
                                        <span class="trend-arrow">{% if m.trend == 'up' %}&#8593;{% elif m.trend == 'down' %}&#8595;{% else %}&#8596;{% endif %}</span>
                                        {{ m.change }}
                                    </span>
                                    {% endif %}
                                </div>
                                {% endfor %}
                            </div>
                            {% elif section.type == "list" and section.items %}
                            <ul>{% for item in section.items %}<li>{{ item }}</li>{% endfor %}</ul>
                            {% elif section.type == "text" and section.content %}
                            <p>{{ section.content|linebreaksbr }}</p>
                            {% elif section.type == "data" and section.data %}
                            <pre class="code-block code-block--compact">{{ section.data|pprint }}</pre>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}

                {# ---- Fallback: legacy text-based rendering ---- #}
                {% if not run.exit_report.sections and not run.exit_report.metrics %}

                {% if run.exit_report.what_worked %}
                <div class="step-findings step-findings--success">
                    <h4>What Worked</h4>
                    {% if run.exit_report.what_worked.0 %}
                    <ul>{% for item in run.exit_report.what_worked %}<li>{{ item }}</li>{% endfor %}</ul>
                    {% else %}
                    <p>{{ run.exit_report.what_worked }}</p>
                    {% endif %}
                </div>
                {% endif %}

                {% if run.exit_report.what_failed %}
                <div class="step-findings step-findings--failure">
                    <h4>What Failed</h4>
                    {% if run.exit_report.what_failed.0 %}
                    <ul>{% for item in run.exit_report.what_failed %}<li>{{ item }}</li>{% endfor %}</ul>
                    {% else %}
                    <p>{{ run.exit_report.what_failed }}</p>
                    {% endif %}
                </div>
                {% endif %}

                {% if run.exit_report.recommendations %}
                <div class="step-findings step-findings--recommendations">
                    <h4>Recommendations</h4>
                    {% if run.exit_report.recommendations.0 %}
                    <ul>{% for item in run.exit_report.recommendations %}<li>{{ item }}</li>{% endfor %}</ul>
                    {% else %}
                    <p>{{ run.exit_report.recommendations }}</p>
                    {% endif %}
                </div>
                {% endif %}

                {% if run.exit_report.output %}
                <details class="step-output-details">
                    <summary>Output</summary>
                    <pre class="code-block code-block--compact">{{ run.exit_report.output|truncatechars:500 }}</pre>
                </details>
                {% endif %}

                {% if run.exit_report.key_findings %}
                <details class="step-output-details">
                    <summary>Key Findings ({{ run.exit_report.key_findings|length }})</summary>
                    <ul>{% for item in run.exit_report.key_findings %}<li>{{ item }}</li>{% endfor %}</ul>
                </details>
                {% endif %}

                {% endif %}{# end fallback #}

                <a href="{% url 'dashboard:run_detail' run.service.slug run.id %}" class="btn btn-secondary btn-sm">
                    Full Report
                </a>
            {% elif run.status == "failed" %}
                {% if run.exit_report.error %}
                <div class="step-findings step-findings--failure">
                    <h4>Error</h4>
                    <pre class="code-block code-block--compact">{{ run.exit_report.error }}</pre>
                </div>
                {% endif %}
                {% if run.exit_report.what_failed %}
                <div class="step-findings step-findings--failure">
                    <h4>What Failed</h4>
                    <ul>{% for item in run.exit_report.what_failed %}<li>{{ item }}</li>{% endfor %}</ul>
                </div>
                {% endif %}
                <a href="{% url 'dashboard:run_detail' run.service.slug run.id %}" class="btn btn-secondary btn-sm">
                    Full Report
                </a>
            {% endif %}
        </div>
    </div>

    {% if not forloop.last %}
    <div class="pipeline-arrow">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
    </div>
    {% endif %}
    {% endfor %}
</div>

<!-- Summary (rendered by JS when complete, or server-side if already done) -->
<div id="pipeline-summary" {% if not all_complete %}style="display:none"{% endif %}>
{% if all_complete %}
<div class="section pipeline-summary">
    <h2>Summary</h2>
    <div class="stats-bar">
        <div class="stat-box">
            <span class="stat-number">{{ runs|length }}</span>
            <span class="stat-label">Services</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">{{ group.status|title }}</span>
            <span class="stat-label">Result</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">{{ group.created_at|timesince }}</span>
            <span class="stat-label">Total Time</span>
        </div>
    </div>

    {% with last_run=runs.last %}
    {% if last_run and last_run.exit_report %}
    <div class="final-output">
        <h3>Final Output</h3>

        {% if last_run.exit_report.recommendations %}
        <div class="report-section report-recommendations">
            <h3>Recommendations</h3>
            {% if last_run.exit_report.recommendations.0 %}
            <ul>{% for item in last_run.exit_report.recommendations %}<li>{{ item }}</li>{% endfor %}</ul>
            {% else %}
            <p>{{ last_run.exit_report.recommendations }}</p>
            {% endif %}
        </div>
        {% endif %}

        {% if last_run.exit_report.output %}
        <div class="report-section">
            <h3>Output</h3>
            <pre class="code-block">{{ last_run.exit_report.output }}</pre>
        </div>
        {% endif %}

        <details class="raw-report">
            <summary>Raw Exit Report (JSON)</summary>
            <pre class="code-block">{{ last_run.exit_report|pprint }}</pre>
        </details>
    </div>
    {% endif %}
    {% endwith %}
</div>

<div style="text-align: center; margin-top: 1.5rem;">
    <a href="{% url 'dashboard:index' %}" class="btn btn-primary">Run Another Pipeline</a>
</div>
{% endif %}
</div>
{% endblock %}

{% block extra_js %}
<script>
(function() {
    var allComplete = {{ all_complete|yesno:"true,false" }};
    if (allComplete) return;

    var groupId = {{ group.id }};
    var apiUrl = '{% url "dashboard:pipeline_status_api" group.id %}';
    var pollInterval = 2000;
    var maxErrors = 10;
    var errorCount = 0;
    var timer = null;

    var statusClasses = {
        pending: 'badge-pending',
        running: 'badge-running',
        completed: 'badge-completed',
        failed: 'badge-failed'
    };

    var stepClasses = {
        pending: 'pipeline-step--pending',
        running: 'pipeline-step--running',
        completed: 'pipeline-step--completed',
        failed: 'pipeline-step--failed'
    };

    function escapeHtml(str) {
        var d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    function renderList(items) {
        if (!items) return '';
        if (Array.isArray(items)) {
            return '<ul>' + items.map(function(i) { return '<li>' + escapeHtml(String(i)) + '</li>'; }).join('') + '</ul>';
        }
        return '<p>' + escapeHtml(String(items)) + '</p>';
    }

    function renderMetricTile(m) {
        var trendArrow = m.trend === 'up' ? '&#8593;' : (m.trend === 'down' ? '&#8595;' : '&#8596;');
        var trendHtml = m.change
            ? '<span class="metric-trend metric-trend--' + escapeHtml(m.trend || 'neutral') + '">' +
              '<span class="trend-arrow">' + trendArrow + '</span> ' + escapeHtml(String(m.change)) + '</span>'
            : '';
        return '<div class="metric-tile">' +
            '<span class="metric-label">' + escapeHtml(String(m.label)) + '</span>' +
            '<span class="metric-value">' + escapeHtml(String(m.value)) + '</span>' +
            trendHtml + '</div>';
    }

    function renderSection(section) {
        var bodyHtml = '';
        if (section.type === 'metrics' && section.data) {
            bodyHtml = '<div class="metrics-grid">' +
                section.data.map(renderMetricTile).join('') + '</div>';
        } else if (section.type === 'list' && section.items) {
            bodyHtml = '<ul>' + section.items.map(function(i) {
                return '<li>' + escapeHtml(String(i)) + '</li>';
            }).join('') + '</ul>';
        } else if (section.type === 'text' && section.content) {
            bodyHtml = '<p>' + escapeHtml(String(section.content)).replace(/\n/g, '<br>') + '</p>';
        } else if (section.type === 'data' && section.data) {
            bodyHtml = '<pre class="code-block code-block--compact">' +
                escapeHtml(JSON.stringify(section.data, null, 2)) + '</pre>';
        }
        return '<div class="data-card"><div class="data-card-header"><h3>' +
            escapeHtml(String(section.title)) + '</h3></div>' +
            '<div class="data-card-body">' + bodyHtml + '</div></div>';
    }

    function renderStepBody(run) {
        var html = '';
        if (run.status === 'pending') return '';
        if (run.status === 'running') {
            return '<p class="running-text"><span class="spinner"></span> Processing...</p>';
        }
        if (run.status === 'completed') {
            /* Duration and tokens */
            if (run.duration_seconds != null || run.tokens_used) {
                html += '<div class="step-meta">';
                if (run.duration_seconds != null) {
                    html += '<span class="step-meta-item"><span class="step-meta-icon">&#9201;</span> ' +
                        run.duration_seconds.toFixed(1) + 's</span>';
                }
                if (run.tokens_used) {
                    html += '<span class="step-meta-item"><span class="step-meta-icon">&#9671;</span> ' +
                        run.tokens_used + ' tokens</span>';
                }
                html += '</div>';
            }
            var er = run.exit_report || {};

            /* Structured rendering path */
            var hasStructured = (er.metrics && er.metrics.length) || (er.sections && er.sections.length);

            if (er.metrics && er.metrics.length) {
                html += '<div class="metrics-grid fade-in stagger-children">' +
                    er.metrics.map(renderMetricTile).join('') + '</div>';
            }

            if (er.sections && er.sections.length) {
                html += '<div class="fade-in stagger-children">' +
                    er.sections.map(renderSection).join('') + '</div>';
            }

            /* Fallback: legacy text rendering */
            if (!hasStructured) {
                if (er.what_worked) {
                    html += '<div class="step-findings step-findings--success"><h4>What Worked</h4>' +
                        renderList(er.what_worked) + '</div>';
                }
                if (er.what_failed) {
                    html += '<div class="step-findings step-findings--failure"><h4>What Failed</h4>' +
                        renderList(er.what_failed) + '</div>';
                }
                if (er.recommendations) {
                    html += '<div class="step-findings step-findings--recommendations"><h4>Recommendations</h4>' +
                        renderList(er.recommendations) + '</div>';
                }
                if (er.output) {
                    var truncated = String(er.output).length > 500
                        ? String(er.output).substring(0, 500) + '...'
                        : String(er.output);
                    html += '<details class="step-output-details"><summary>Output</summary>' +
                        '<pre class="code-block code-block--compact">' + escapeHtml(truncated) + '</pre></details>';
                }
                if (er.key_findings && Array.isArray(er.key_findings) && er.key_findings.length) {
                    html += '<details class="step-output-details"><summary>Key Findings (' +
                        er.key_findings.length + ')</summary>' + renderList(er.key_findings) + '</details>';
                }
            }

            html += '<a href="/service/' + encodeURIComponent(run.service_slug) +
                '/run/' + run.id + '/" class="btn btn-secondary btn-sm">Full Report</a>';
        }
        if (run.status === 'failed') {
            var er = run.exit_report || {};
            if (er.error) {
                html += '<div class="step-findings step-findings--failure"><h4>Error</h4>' +
                    '<pre class="code-block code-block--compact">' + escapeHtml(String(er.error)) + '</pre></div>';
            }
            if (er.what_failed) {
                html += '<div class="step-findings step-findings--failure"><h4>What Failed</h4>' +
                    renderList(er.what_failed) + '</div>';
            }
            html += '<a href="/service/' + encodeURIComponent(run.service_slug) +
                '/run/' + run.id + '/" class="btn btn-secondary btn-sm">Full Report</a>';
        }
        return html;
    }

    function poll() {
        fetch(apiUrl)
            .then(function(r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(function(data) {
                errorCount = 0;

                /* Update each step */
                data.runs.forEach(function(run) {
                    var stepEl = document.querySelector('[data-run-id="' + run.id + '"]');
                    if (!stepEl) return;

                    /* Update step border class */
                    Object.values(stepClasses).forEach(function(c) { stepEl.classList.remove(c); });
                    stepEl.classList.add(stepClasses[run.status] || stepClasses.pending);

                    /* Update step number style */
                    var numEl = stepEl.querySelector('.pipeline-step-number');
                    /* number styling comes from parent class, already handled */

                    /* Update badge */
                    var badgeEl = stepEl.querySelector('.step-badge');
                    if (badgeEl) {
                        Object.values(statusClasses).forEach(function(c) { badgeEl.classList.remove(c); });
                        badgeEl.classList.add(statusClasses[run.status] || statusClasses.pending);
                        badgeEl.textContent = run.status_display;
                    }

                    /* Update body content */
                    var bodyEl = stepEl.querySelector('.step-body-content');
                    if (bodyEl && (run.status === 'completed' || run.status === 'failed' || run.status === 'running')) {
                        bodyEl.innerHTML = renderStepBody(run);
                    }
                });

                /* Update header */
                var titleEl = document.getElementById('pipeline-title');
                var headerBadge = document.getElementById('pipeline-badge');

                if (data.all_complete) {
                    if (titleEl) titleEl.textContent = 'Pipeline Complete';
                    if (headerBadge) {
                        headerBadge.className = 'badge badge-' + data.group_status;
                        headerBadge.textContent = data.group_status_display;
                    }

                    /* Hide polling indicator */
                    var ind = document.getElementById('polling-indicator');
                    if (ind) ind.style.display = 'none';

                    /* Show summary -- reload page once to get server-rendered summary */
                    clearInterval(timer);
                    window.location.reload();
                }
            })
            .catch(function(err) {
                errorCount++;
                var label = document.getElementById('polling-label');
                if (label) {
                    label.textContent = 'Connection issue, retrying... (' + errorCount + '/' + maxErrors + ')';
                }
                if (errorCount >= maxErrors) {
                    clearInterval(timer);
                    if (label) label.textContent = 'Connection lost. Refresh the page to retry.';
                    var dot = document.querySelector('#polling-indicator .refresh-dot');
                    if (dot) dot.style.animation = 'none';
                }
            });
    }

    timer = setInterval(poll, pollInterval);
})();
</script>
{% endblock %}{% endraw %}
