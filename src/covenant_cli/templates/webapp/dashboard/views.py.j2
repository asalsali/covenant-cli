"""{{ project_name }} -- dashboard views."""

import os

from django.http import HttpResponseNotAllowed, JsonResponse
from django.shortcuts import get_object_or_404, redirect, render

from core.models import AgentRun, RunGroup, Service
from dashboard.runner import run_pipeline_background, run_service_background


def _build_placeholder(services):
    """Build a context-aware placeholder from registered service names."""
    names = [s.name for s in services]
    if not names:
        return "Describe your task..."
    if len(names) == 1:
        return f"Describe a task for {names[0]}..."
    joined = ", ".join(names[:-1]) + f" and {names[-1]}"
    return f"Enter a task for {joined} to process..."


def index(request):
    """Homepage: hero input form + services + recent pipeline runs."""
    try:
        services = Service.objects.all()
        recent_runs = AgentRun.objects.select_related("service")[:5]
        recent_pipelines = RunGroup.objects.all()[:5]
    except Exception:
        # Tables don't exist yet -- user needs to run migrate
        return render(request, "dashboard/index.html", {
            "services": [],
            "recent_runs": [],
            "recent_pipelines": [],
            "needs_migrate": True,
            "input_placeholder": "Describe your task...",
            "api_key_ok": bool(os.environ.get("OPENAI_API_KEY")),
        })
    return render(
        request,
        "dashboard/index.html",
        {
            "services": services,
            "recent_runs": recent_runs,
            "recent_pipelines": recent_pipelines,
            "input_placeholder": _build_placeholder(services),
            "api_key_ok": bool(os.environ.get("OPENAI_API_KEY")),
        },
    )


def service_detail(request, slug):
    """Show a single service with its run history."""
    service = get_object_or_404(Service, slug=slug)
    runs = service.runs.all()[:25]
    return render(
        request,
        "dashboard/service_detail.html",
        {"service": service, "runs": runs},
    )


def run_detail(request, slug, run_id):
    """Show a single run with its full exit report."""
    service = get_object_or_404(Service, slug=slug)
    run = get_object_or_404(AgentRun, id=run_id, service=service)
    return render(
        request,
        "dashboard/run_detail.html",
        {"service": service, "run": run},
    )


def trigger_run(request, slug):
    """Trigger a new run for a service (POST only)."""
    if request.method != "POST":
        return HttpResponseNotAllowed(["POST"])

    service = get_object_or_404(Service, slug=slug)
    user_input = request.POST.get("user_input", "")
    run = AgentRun.objects.create(
        service=service,
        input_data={"query": user_input} if user_input else {},
    )
    run_service_background(run.id)
    return redirect("dashboard:service_detail", slug=service.slug)


def run_pipeline(request):
    """Launch a full pipeline run across all active services (POST only)."""
    if request.method != "POST":
        return HttpResponseNotAllowed(["POST"])

    user_input = request.POST.get("user_input", "").strip()
    if not user_input:
        return redirect("dashboard:index")

    services = Service.objects.filter(status__in=["registered", "active"])
    if not services.exists():
        return redirect("dashboard:index")

    # Create a RunGroup and one AgentRun per service
    group = RunGroup.objects.create(user_input=user_input)
    for service in services:
        AgentRun.objects.create(
            service=service,
            run_group=group,
            status="pending",
        )

    run_pipeline_background(group.id)
    return redirect("dashboard:pipeline_results", group_id=group.id)


def pipeline_results(request, group_id):
    """Show pipeline progress and results."""
    group = get_object_or_404(RunGroup, id=group_id)
    runs = group.runs.select_related("service").order_by("id")
    all_complete = group.all_complete()

    return render(
        request,
        "dashboard/pipeline_results.html",
        {
            "group": group,
            "runs": runs,
            "all_complete": all_complete,
            "api_key_ok": bool(os.environ.get("OPENAI_API_KEY")),
        },
    )


# ---------------------------------------------------------------------------
# JSON API endpoints
# ---------------------------------------------------------------------------

def pipeline_status_api(request, group_id):
    """Return JSON status for a pipeline run group (used by JS polling)."""
    group = get_object_or_404(RunGroup, id=group_id)
    runs = group.runs.select_related("service").order_by("id")

    run_data = []
    for run in runs:
        entry = {
            "id": run.id,
            "service_name": run.service.name,
            "service_slug": run.service.slug,
            "status": run.status,
            "status_display": run.get_status_display(),
            "duration_seconds": run.duration_seconds,
            "tokens_used": run.tokens_used,
            "exit_report": run.exit_report,
        }
        run_data.append(entry)

    return JsonResponse({
        "group_id": group.id,
        "group_status": group.status,
        "group_status_display": group.get_status_display(),
        "all_complete": group.all_complete(),
        "runs": run_data,
    })


def api_key_status(request):
    """Return whether the OPENAI_API_KEY is configured."""
    key = os.environ.get("OPENAI_API_KEY", "")
    return JsonResponse({
        "configured": bool(key),
        "masked": f"{key[:4]}...{key[-4:]}" if len(key) > 8 else "",
    })
